# Create a Telegram bot with @BotFather and keep this value private.
TELEGRAM_BOT_TOKEN=

# The chat ID that receives your personal loan reminders.
# Send a message to your bot first, then get it from Telegram's getUpdates API.
TELEGRAM_ADMIN_CHAT_ID=

# A long random value used to protect scheduled reminder calls.
CRON_SECRET=

# Supabase PostgreSQL transaction pooler URL (never expose this in the browser).
DATABASE_URL=

# Generate with: npx bcrypt "your-admin-password" 12
ADMIN_PASSWORD_HASH=

# A separate long random secret for signing the admin session cookie.
SESSION_SECRET=
